# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
site/
*.egg-info/
*.egg
.eggs/
wheels/

# Test, coverage, lint, and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
tmp/
temp/

# Large/local datasets. Keep documentation and placeholders trackable.
data/*
!data/README.md
!data/.gitkeep
datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

